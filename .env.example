# This file is documentation. Copy deliberately; no external sending by default.
# Public contact is fixed in src/lib/contact.ts: veytronatech@gmail.com.
# NEXT_PUBLIC_CONTACT_EMAIL is no longer used; no personal-contact override.
# Verified HTTPS origin only; unset => no canonical, no indexing, empty sitemap.
SITE_URL=

# Server-only. Do not rename these with NEXT_PUBLIC_. No account is assumed.
INQUIRY_DELIVERY_MODE=disabled
# Replacement release also locks src/lib/inquiry-release.ts to false.
# Separate authorization and a reviewed release are required to enable it.
RESEND_API_KEY=
# Bare verified-domain address, e.g. inquiries@your-owned-domain (no display name).
INQUIRY_FROM=
# Set ONLY after the owner verifies this exact sending domain in Resend.
# Operator acknowledgement, not an automatic DNS/provider verification.
INQUIRY_VERIFIED_SENDER_DOMAIN=
# Host-owned durable atomic abuse gate, HTTPS POST; see PRODUCTION_SETUP.md.
INQUIRY_ABUSE_URL=
INQUIRY_ABUSE_TOKEN=
INQUIRY_ABUSE_SALT=

# Optional compatibility policy, logs violations to browser console only.
# Not a full enforced script policy and not an analytics collector.
VEYTRONA_CSP_REPORT_ONLY=0
